.gradle
.kotlin
*/build

# ─── Standalone A2UI project — infrastructure ─────────────────────────────
local.properties
.idea/
*.bak
# Symlink to the external KuiklyUI checkout — regenerated by
# `scripts/link-kuikly.sh` on demand; never committed.
.kuikly-external
# Read-only rsync mirror of <kuikly>/core-render-ohos, needed because
# DevEco / hvigor `build-profile.json5` `modules[].srcPath` rejects any
# path whose real target lies outside the workspace (rules out both an
# absolute path and a symlink into the external Kuikly checkout).
# The mirror is regenerated (and re-chmod'd read-only) by
# `scripts/link-kuikly.sh`; never committed.
/core-render-ohos



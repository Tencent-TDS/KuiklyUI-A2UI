# ─── Synced iOS demo assets ───────────────────────────────────────────────
# Source of truth on Android; iOS copies are auto-generated by
# sync_demo_assets.sh during each target's setup.sh.
# NativePage + KuiklyPage: components / custom_components / custom_functions / icons
iosAppForNativePage/Resources/a2ui_components/
iosAppForNativePage/Resources/a2ui_custom_components/
iosAppForNativePage/Resources/a2ui_custom_functions/
iosAppForNativePage/Resources/a2ui_icons/
iosAppForKuiklyPage/Resources/a2ui_components/
iosAppForKuiklyPage/Resources/a2ui_custom_components/
iosAppForKuiklyPage/Resources/a2ui_custom_functions/
iosAppForKuiklyPage/Resources/a2ui_icons/
# Test-only assets (databinding / theme / function tests + misc).
iosAppForTest/Resources/a2ui_databinding_tests/
iosAppForTest/Resources/a2ui_examples/
iosAppForTest/Resources/a2ui_function_tests/
iosAppForTest/Resources/a2ui_theme_tests/
iosAppForTest/Resources/app/
iosAppForTest/Resources/compose/
iosAppForTest/Resources/demo/
iosAppForTest/Resources/router_page/

# ─── Synced ohos demo assets (per-app, 4-way split) ──────────────────────
# Source of truth on Android; ohos copies are auto-generated by
# sync_demo_assets.sh (invoked from each ohosAppFor* module's hvigor
# pre-build hook). Kept out of VCS to avoid duplication with androidAppFor*.
#
# NativePage: component / custom / icon story (mirrors iosAppForNativePage).
ohosAppForNativePage/entry/src/main/resources/rawfile/a2ui_components/
ohosAppForNativePage/entry/src/main/resources/rawfile/a2ui_custom_components/
ohosAppForNativePage/entry/src/main/resources/rawfile/a2ui_custom_functions/
ohosAppForNativePage/entry/src/main/resources/resfile/a2ui_icons/
# KuiklyPage: same set as NativePage.
ohosAppForKuiklyPage/entry/src/main/resources/rawfile/a2ui_components/
ohosAppForKuiklyPage/entry/src/main/resources/rawfile/a2ui_custom_components/
ohosAppForKuiklyPage/entry/src/main/resources/rawfile/a2ui_custom_functions/
ohosAppForKuiklyPage/entry/src/main/resources/resfile/a2ui_icons/
# BothPages: intentionally no synced assets — parity with androidAppForBothPages / iosAppForBothPages.
# Test: full test-only asset set (databinding / theme / function tests + misc).
ohosAppForTest/entry/src/main/resources/rawfile/a2ui_databinding_tests/
ohosAppForTest/entry/src/main/resources/rawfile/a2ui_examples/
ohosAppForTest/entry/src/main/resources/rawfile/a2ui_function_tests/
ohosAppForTest/entry/src/main/resources/rawfile/a2ui_theme_tests/
ohosAppForTest/entry/src/main/resources/rawfile/app/
ohosAppForTest/entry/src/main/resources/rawfile/compose/
ohosAppForTest/entry/src/main/resources/rawfile/demo/
ohosAppForTest/entry/src/main/resources/rawfile/router_page/

# ohos KMP artefacts fanned out by 2.0_a2ui_ohos_build{,_release}.sh.
# libshared.so / libshared_api.h are generated locally per-developer;
# keep out of VCS so PRs don't churn on binary diffs.
ohosAppForKuiklyPage/entry/libs/
ohosAppForKuiklyPage/entry/src/main/cpp/thirdparty/biz_entry/libshared_api.h
ohosAppForNativePage/entry/libs/
ohosAppForNativePage/entry/src/main/cpp/thirdparty/biz_entry/libshared_api.h
ohosAppForBothPages/entry/libs/
ohosAppForBothPages/entry/src/main/cpp/thirdparty/biz_entry/libshared_api.h
ohosAppForTest/entry/libs/
ohosAppForTest/entry/src/main/cpp/thirdparty/biz_entry/libshared_api.h

# Synced assets for the Native-Page Android demo app.
# Source of truth lives at androidAppForKuiklyPage/src/main/assets/ and is
# copied here by the `syncAssetsFromKuiklyPage` Gradle task (see
# androidAppForNativePage/build.gradle.kts) before every build.
androidAppForNativePage/src/main/assets/


require_relative '../scripts/lib/kuikly_cocoapods'

# Resolve Kuikly render pod source depending on `kuikly.useSource`.
# See `scripts/lib/kuikly_cocoapods.rb` for the resolution order.
kuikly_pod_version = A2UI::KuiklyCocoapods.render_pod_version(__dir__)
kuikly_pod_options = A2UI::KuiklyCocoapods.render_pod_options(__dir__)

platform :ios, '15.0'

target 'A2UIDemoApp' do
  use_modular_headers!

  # A2UI Kotlin/Native framework - auto-generated podspec by cocoapods plugin
  # This triggers Gradle syncFramework on each Xcode build (debug/release follows Xcode config)
  pod 'a2ui', :path => '../a2ui'

  # Kuikly iOS Render (core-render-ios).
  # Dual-mode via `kuikly.useSource`: either local `:path` (source
  # debugging alongside KuiklyUI) or published CocoaPods trunk version.
  if kuikly_pod_version
    pod 'OpenKuiklyIOSRender', kuikly_pod_version
  else
    pod 'OpenKuiklyIOSRender', **kuikly_pod_options
  end

  # A2UI iOS Render - local podspec
  pod 'OpenKuiklyA2UIIOSRender', :path => '../a2ui-render-ios/'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end

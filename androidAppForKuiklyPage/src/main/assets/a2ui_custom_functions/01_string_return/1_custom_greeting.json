      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "cf-str-1",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          { "id": "col", "component": "Column", "children": ["title", "result"] },
          { "id": "title", "component": "Text", "text": "getGreeting(name) → String", "variant": "caption" },
          {
            "id": "result",
            "component": "Text",
            "text": {
              "call": "getGreeting",
              "args": {
                "name": { "path": "/userName" }
              },
              "returnType": "string"
            },
            "variant": "h3"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "cf-str-1",
        "value": { "userName": "Kuikly" }
      }
    }
  ]
}
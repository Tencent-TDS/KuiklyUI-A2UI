{
  "name": "自定义函数返回 String",
  "description": "自定义函数 getGreeting 返回字符串，绑定到 Text.text。Demo 注册了 getGreeting 函数，接收 name 参数，返回 'Hello, {name}!'。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "cf-str-1",

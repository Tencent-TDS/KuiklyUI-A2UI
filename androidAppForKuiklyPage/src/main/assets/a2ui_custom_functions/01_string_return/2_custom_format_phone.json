{
  "name": "自定义函数格式化电话号码",
  "description": "自定义函数 formatPhone 接收 phone 参数，返回格式化后的电话号码字符串（如 138-0000-1234）。",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "cf-str-2",
        "catalogId": "custom_functions_catalog_v1_0.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "cf-str-2",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "title",
              "phone"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "formatPhone(phone) → String",
            "variant": "caption"
          },
          {
            "id": "phone",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "#### ${formatPhone(phone:${/rawPhone})}"
              }
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "cf-str-2",
        "value": {
          "rawPhone": "13800001234"
        }
      }
    }
  ]
}

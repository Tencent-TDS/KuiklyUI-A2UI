{
  "name": "自定义函数返回 Boolean 与标准 ValidationResult 校验",
  "description": "isVip 返回 Boolean 并响应 userLevel 更新；按钮使用官方 numeric ValidationResult 校验同一 VIP 阈值，不将 Boolean 函数冒充 CheckFunctionCall。",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "cf-bool-1",
        "catalogId": "custom_functions_catalog_v1_0.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "cf-bool-1",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "title",
              "vip_btn",
              "info"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "isVip(level) → Boolean；numeric → ValidationResult",
            "variant": "caption"
          },
          {
            "id": "vip_btn_label",
            "component": "Text",
            "text": "🌟 进入 VIP 专区"
          },
          {
            "id": "vip_btn",
            "component": "Button",
            "child": "vip_btn_label",
            "variant": "primary",
            "action": {
              "event": {
                "name": "enterVipZone",
                "context": {
                  "level": {
                    "@path": "/userLevel"
                  }
                }
              }
            },
            "@checks": [
              {
                "condition": {
                  "@call": "numeric",
                  "args": {
                    "value": {
                      "@path": "/userLevel"
                    },
                    "min": 3
                  }
                },
                "message": "仅 VIP 用户（level >= 3）可进入"
              }
            ]
          },
          {
            "id": "info",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "当前 userLevel = ${/userLevel}，isVip 返回 ${isVip(level:${/userLevel})}"
              }
            },
            "variant": "body"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "cf-bool-1",
        "value": {
          "userLevel": 5
        }
      }
    }
  ]
}

{
  "name": "Text - function formatString",
  "description": "Text rendered via formatString function with ${path} interpolation",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "test-text-format-string",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "test-text-format-string",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main_column"
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": [
              "greeting",
              "summary"
            ]
          },
          {
            "id": "greeting",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "#### Hello, ${/firstName} ${/lastName}!"
              }
            }
          },
          {
            "id": "summary",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "You have ${/unread} unread messages and ${/notifications} new notifications."
              }
            },
            "variant": "body"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "test-text-format-string",
        "value": {
          "firstName": "Alex",
          "lastName": "Chen",
          "unread": 5,
          "notifications": 12
        }
      }
    }
  ]
}

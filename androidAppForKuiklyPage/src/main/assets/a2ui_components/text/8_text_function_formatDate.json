{
  "name": "Text - function formatDate",
  "description": "Text rendered via formatDate function (ISO 8601 → MMM d, yyyy)",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "test-text-format-date",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "test-text-format-date",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main_column"
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": [
              "label",
              "date_long",
              "date_short"
            ]
          },
          {
            "id": "label",
            "component": "Text",
            "text": "PUBLISHED",
            "variant": "caption"
          },
          {
            "id": "date_long",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "##### ${formatDate(value:${/publishedAt}, format:'MMM d, yyyy')}"
              }
            }
          },
          {
            "id": "date_short",
            "component": "Text",
            "text": {
              "@call": "formatDate",
              "args": {
                "value": {
                  "@path": "/publishedAt"
                },
                "format": "yyyy/MM/dd"
              }
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "test-text-format-date",
        "value": {
          "publishedAt": "2025-12-15T17:30:00Z"
        }
      }
    }
  ]
}

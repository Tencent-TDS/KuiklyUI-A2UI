{
  "name": "CheckBox - value data binding",
  "description": "CheckBox value bound to /dark; reflects current state",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "test-cb-binding",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "test-cb-binding",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "cb",
              "echo"
            ]
          },
          {
            "id": "cb",
            "component": "CheckBox",
            "label": "Enable dark mode",
            "value": {
              "path": "/dark"
            }
          },
          {
            "id": "echo",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "Dark mode is: ${/dark}"
              },
              "returnType": "string"
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "test-cb-binding",
        "value": {
          "dark": false
        }
      }
    }
  ]
}
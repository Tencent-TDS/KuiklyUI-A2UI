{
  "name": "TextField - email and regex validation via @checks",
  "description": "Both editable values use model bindings. The email function and regex function validate input through A2UI 1.0 @checks.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "test-tf-regexp",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "test-tf-regexp",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "tf_checks",
              "tf"
            ]
          },
          {
            "id": "tf_checks",
            "component": "TextField",
            "label": "Email (email via @checks)",
            "value": {
              "@path": "/email"
            },
            "variant": "shortText",
            "@checks": [
              {
                "condition": {
                  "@call": "email",
                  "args": {
                    "value": {
                      "@path": "/email"
                    }
                  }
                },
                "message": "Please enter a valid email address"
              }
            ]
          },
          {
            "id": "tf",
            "component": "TextField",
            "label": "Email (regex via @checks)",
            "value": {
              "@path": "/tf_validation_value"
            },
            "variant": "shortText",
            "@checks": [
              {
                "condition": {
                  "@call": "regex",
                  "args": {
                    "value": {
                      "@path": "/tf_validation_value"
                    },
                    "pattern": "^[^@]+@[^@]+\\.[^@]+$"
                  }
                },
                "message": "Please enter a value matching the required pattern"
              }
            ]
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "test-tf-regexp",
        "value": {
          "email": "",
          "tf_validation_value": ""
        }
      }
    }
  ]
}

{
  "name": "Slider - value binding",
  "description": "Slider value bound to /progress",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "test-sl-binding",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "test-sl-binding",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "s",
              "echo"
            ]
          },
          {
            "id": "s",
            "component": "Slider",
            "label": "Progress",
            "min": 0,
            "max": 100,
            "value": {
              "path": "/progress"
            }
          },
          {
            "id": "echo",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "Progress: ${/progress}%"
              },
              "returnType": "string"
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "test-sl-binding",
        "value": {
          "progress": 45
        }
      }
    }
  ]
}
{
  "name": "ChoicePicker - value binding",
  "description": "ChoicePicker value bound to /picked array",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "test-cp-binding",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "test-cp-binding",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "cp",
              "echo"
            ]
          },
          {
            "id": "cp",
            "component": "ChoicePicker",
            "label": "Topics",
            "variant": "multipleSelection",
            "displayStyle": "chips",
            "options": [
              {
                "label": "Sports",
                "value": "sports"
              },
              {
                "label": "News",
                "value": "news"
              },
              {
                "label": "Tech",
                "value": "tech"
              },
              {
                "label": "Movies",
                "value": "movies"
              }
            ],
            "value": {
              "path": "/picked"
            }
          },
          {
            "id": "echo",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "Selected: ${/picked}"
              },
              "returnType": "string"
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "test-cp-binding",
        "value": {
          "picked": [
            "tech",
            "movies"
          ]
        }
      }
    }
  ]
}
{
  "name": "DateTimeInput - value data binding",
  "description": "DateTimeInput value bound to /departure",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "test-dt-binding",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "test-dt-binding",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "d",
              "echo"
            ]
          },
          {
            "id": "d",
            "component": "DateTimeInput",
            "label": "Departure",
            "value": {
              "@path": "/departure"
            },
            "enableDate": true,
            "enableTime": true
          },
          {
            "id": "echo",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "ISO: ${/departure}"
              }
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "test-dt-binding",
        "value": {
          "departure": "2026-12-24T08:00:00"
        }
      }
    }
  ]
}

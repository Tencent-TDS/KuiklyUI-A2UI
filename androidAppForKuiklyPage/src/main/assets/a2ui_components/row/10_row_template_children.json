            },
            "justify": "start"
          },
          {
            "id": "tag",
            "component": "Text",
            "text": {
              "path": "/label"
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "test-row-template",
        "value": {
          "tags": [
            {
              "label": "Kotlin"
            },
            {
              "label": "Compose"
            },
            {
              "label": "iOS"
            },
            {
              "label": "A2UI"
            }
          ]
        }
      }
    }
  ]
}
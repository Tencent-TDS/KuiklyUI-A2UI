require_relative '../scripts/lib/kuikly_cocoapods'
require_relative '../scripts/lib/a2ui_cocoapods'

# Resolve Kuikly render pod source depending on `kuikly.useSource`:
#   - source  mode → `:path => <local KuiklyUI checkout>`
#   - artifact mode → `'<kuikly.version>'` from CocoaPods trunk
# Mirrors `KuiklyDep` on the Gradle side; see
# `scripts/lib/kuikly_cocoapods.rb` for the resolution order.
kuikly_pod_version = A2UI::KuiklyCocoapods.render_pod_version(__dir__)
kuikly_pod_options = A2UI::KuiklyCocoapods.render_pod_options(__dir__)

# Resolve A2UI render pod source depending on `a2ui.useSource` (default
# source — same-repo dev loop). Mirrors `A2uiDep` on the Gradle side;
# see `scripts/lib/a2ui_cocoapods.rb`.
a2ui_pod_version = A2UI::A2uiCocoapods.render_pod_version(__dir__)
a2ui_pod_options = A2UI::A2uiCocoapods.render_pod_options(__dir__)

platform :ios, '15.0'

target 'A2UIDemoApp' do
  use_modular_headers!

  # A2UI DSL demo pages (KMP business module) — provides the `@Page("A2UISurfaceDemo")`
  # and `@Page("ComposeSampleWithA2UI")` Pager classes that this app hosts through
  # KuiklyRenderViewController. Mirrors the `:demo` gradle dep used by
  # androidAppForKuiklyPage.
  #
  # Why we do NOT also `pod 'a2ui'` here: A2UIDemo.framework already embeds
  # every Kotlin symbol from `:a2ui` (via `implementation(project(":a2ui"))`
  # in demo/build.2.1.21.gradle.kts), so linking both pods would produce two
  # Kotlin/Native static frameworks with duplicate stdlib-cache symbols. The
  # The render pod (`OpenKuiklyA2UIIOSRender`) resolves `A2UICoreEntry` at runtime via
  # `NSClassFromString`, so it works fine against either framework alone.
  pod 'a2ui_demo', :path => '../demo'
  # Kuikly iOS Render (core-render-ios).
  # Dual-mode via `kuikly.useSource`: either local `:path` (source
  # debugging alongside KuiklyUI) or published CocoaPods trunk version.
  if kuikly_pod_version
    pod 'OpenKuiklyIOSRender', kuikly_pod_version
  else
    pod 'OpenKuiklyIOSRender', **kuikly_pod_options
  end

  # A2UI iOS Render — dual-mode via `a2ui.useSource` (default source):
  # either local `:path` for in-repo dev or published CocoaPods trunk
  # version for artefact validation.
  if a2ui_pod_version
    pod 'OpenKuiklyA2UIIOSRender', a2ui_pod_version
  else
    pod 'OpenKuiklyA2UIIOSRender', **a2ui_pod_options
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end

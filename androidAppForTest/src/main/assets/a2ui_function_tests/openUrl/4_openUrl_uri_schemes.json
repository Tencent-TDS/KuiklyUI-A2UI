            "component": "Column",
            "children": ["title", "hint", "row1", "row2"]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "多 URI scheme",
            "variant": "h5"
          },
          {
            "id": "hint",
            "component": "Text",
            "text": "点击按钮触发系统对应 handler：邮件、拨号、短信、深链。若某 scheme 未注册则可能被吞掉，属于宿主行为。",
            "variant": "caption"
          },
          {
            "id": "row1",
            "component": "Row",
            "children": ["btnMail", "btnTel"],
            "justify": "spaceAround"
          },

                },
                "returnType": "void"
              }
            }
          },
          {
            "id": "btnTel_lbl",
            "component": "Text",
            "text": "📞 tel"
          },
          {
            "id": "btnSms",
            "component": "Button",
            "child": "btnSms_lbl",
            "action": {
              "functionCall": {

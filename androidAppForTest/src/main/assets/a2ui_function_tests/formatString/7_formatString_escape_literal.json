      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "fn-fs-7",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "title",
              "line1",
              "line2",
              "line3"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "formatString 转义规则演示",
            "variant": "h5"
          },
          {
            "id": "line1",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "1) 未转义（会被插值）: hello, ${/user/name}"
              },
              "returnType": "string"
            },
            "variant": "body"
          },
          {
            "id": "line2",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "2) 已转义（输出字面量）: 模板语法为 \\${/user/name}"
              },
              "returnType": "string"
            },
            "variant": "body"
          },
          {
            "id": "line3",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "3) 混合: \\${...} 表示 ${/user/name} 的引用；实际值 = ${/user/name}"
              },
              "returnType": "string"
            },
            "variant": "body"
          }
        ]
      }
    },

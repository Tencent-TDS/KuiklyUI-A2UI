                "message": "温度必须在 16~30 之间"
              }
            ]
          },
          {
            "id": "btn_lbl",
            "component": "Text",
            "text": "确认"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "fn-numeric-3",

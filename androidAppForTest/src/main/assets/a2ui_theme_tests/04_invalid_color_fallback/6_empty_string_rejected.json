{
  "name": "非法值 · 空字符串应被拒绝",
  "description": "theme.primaryColor='' 空字符串不匹配 ^#[0-9a-fA-F]{6}$，应被拒绝并回退默认 #00BFFF。用于验证边界输入不会导致空色/透明色。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "theme-inv-6",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "theme": {
          "primaryColor": ""
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "theme-inv-6",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          {
            "id": "col",
            "component": "Column",
            "children": ["hint", "btn"]
          },
          {
            "id": "hint",
            "component": "Text",
            "text": "theme.primaryColor='' 是空字符串。引擎应回退默认 #00BFFF（浅蓝），下方按钮应为浅蓝而非透明/黑色。",
            "variant": "caption"
          },
          { "id": "btn", "component": "Button", "child": "btn_lbl", "variant": "primary" },
          { "id": "btn_lbl", "component": "Text", "text": "Primary Button（应显示默认浅蓝 #00BFFF）" }
        ]
      }
    }
  ]
}

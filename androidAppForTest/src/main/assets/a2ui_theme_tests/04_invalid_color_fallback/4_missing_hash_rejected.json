        "theme": {
          "primaryColor": "E91E63"
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "theme-inv-4",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          {

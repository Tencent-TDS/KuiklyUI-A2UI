{
  "name": "非法值 · 8 位 hex（带 alpha）应被拒绝",
  "description": "theme.primaryColor='#FF00FFAA' 是 8 位 hex（含 alpha），规范强制 6 位（^#[0-9a-fA-F]{6}$）。应回退默认 #00BFFF。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "theme-inv-3",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
        "theme": {
          "primaryColor": "#FF00FFAA"
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "theme-inv-3",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          {
            "id": "col",
            "component": "Column",
            "children": ["hint", "btn"]
          },
          {
            "id": "hint",
            "component": "Text",
            "text": "theme.primaryColor='#FF00FFAA' 是 8 位 hex（含 alpha），规范要求 6 位。引擎应回退默认 #00BFFF（浅蓝），下方按钮应为浅蓝而非半透明品红。",
            "variant": "caption"
          },
          { "id": "btn", "component": "Button", "child": "btn_lbl", "variant": "primary" },
          { "id": "btn_lbl", "component": "Text", "text": "Primary Button（应显示默认浅蓝 #00BFFF）" }
        ]
      }
    }
  ]
}

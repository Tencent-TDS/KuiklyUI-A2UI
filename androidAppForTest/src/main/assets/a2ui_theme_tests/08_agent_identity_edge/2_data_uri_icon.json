            "height": 32
          },
          {
            "id": "name",
            "component": "Text",
            "text": { "path": "/mirror/agentDisplayName" }
          },
          { "id": "btn", "component": "Button", "child": "btn_lbl", "variant": "primary" },
          { "id": "btn_lbl", "component": "Text", "text": "Primary Button（背景应为青 #009688）" }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "theme-agent-3",
        "value": {
          "mirror": {
            "iconUrl": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=",
            "agentDisplayName": "Data URI Icon Agent"
          }
        }
      }
    }
  ]

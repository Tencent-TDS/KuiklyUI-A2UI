{
  "name": "Text - data binding (path)",
  "description": "Text whose content is bound to a data model path. Verifies updateDataModel reflects into the view.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "test-text-path",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "test-text-path",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main_column"
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": [
              "title",
              "subtitle"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "### ${/title}"
              }
            }
          },
          {
            "id": "subtitle",
            "component": "Text",
            "text": {
              "@path": "/subtitle"
            },
            "variant": "caption"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "test-text-path",
        "value": {
          "title": "Bound Title from Data Model",
          "subtitle": "This caption text is also bound via /subtitle"
        }
      }
    }
  ]
}

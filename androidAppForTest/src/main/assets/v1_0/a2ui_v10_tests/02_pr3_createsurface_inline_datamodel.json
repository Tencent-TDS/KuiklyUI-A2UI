{
  "name": "PR-3 createSurface Inlined dataModel",
  "description": "A2UI v1.0 initializes the data model through createSurface.dataModel before updateComponents arrives. The List template binds existing cart items using relative item paths and @index with offset 1. catalogId identifies the Basic catalog; sendDataModel independently controls model metadata sent to the agent.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "pr3-inline-datamodel-surface",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "cart": {
            "title": "Your cart",
            "items": [
              {
                "name": "Espresso",
                "price": 3.5
              },
              {
                "name": "Croissant",
                "price": 2.8
              },
              {
                "name": "Tea latte",
                "price": 4.2
              }
            ]
          }
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "pr3-inline-datamodel-surface",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "title",
              "items_list"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "variant": "body",
            "text": {
              "@path": "/cart/title"
            }
          },
          {
            "id": "items_list",
            "component": "List",
            "children": {
              "componentId": "item_row",
              "path": "/cart/items"
            }
          },
          {
            "id": "item_row",
            "component": "Row",
            "children": [
              "item_index",
              "item_name",
              "item_price"
            ]
          },
          {
            "id": "item_index",
            "component": "Text",
            "text": {
              "@call": "@index",
              "args": {
                "offset": 1
              }
            }
          },
          {
            "id": "item_name",
            "component": "Text",
            "text": {
              "@path": "name"
            }
          },
          {
            "id": "item_price",
            "component": "Text",
            "text": {
              "@path": "price"
            }
          }
        ]
      }
    }
  ]
}
{
  "name": "PR-2 v1.0 Mixin Keys",
  "description": "A2UI v1.0 strict mode showcase: @path (DynamicString bound to dataModel), @call (DynamicString bound to a custom function result), and @accessibility (attached directly to a Text component rather than inline nested).",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "pr2-mixin-keys-surface",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "userName": "Alice",
          "score": 87
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "pr2-mixin-keys-surface",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["greeting", "score-line", "grade-line"]
          },
          {
            "id": "greeting",
            "component": "Text",
            "variant": "body",
            "text": {
              "@path": "/userName"
            },
            "@accessibility": {
              "description": "Greeting line shows the resolved user name",
              "live": "polite"
            }
          },
          {
            "id": "score-line",
            "component": "Text",
            "text": {
              "@path": "/score"
            },
            "@accessibility": {
              "description": "Current numeric score bound via @path"
            }
          },
          {
            "id": "grade-line",
            "component": "Text",
            "text": { "@call": "formatString", "args": { "value": "score=${/score}" } },
            "@accessibility": {
              "description": "Letter grade derived from the score via a host-registered custom function"
            }
          }
        ]
      }
    }
  ]
}

{
  "name": "PR-8 Multi-Catalog Composition",
  "description": "A2UI v1.0 multi-catalog composition. catalogId points at the basic catalog, while two individual components opt into a custom catalog via the @catalogId component mixin. Demonstrates that lookup disambiguates custom functions / component descriptors per catalog with fallback to the global (name-only) scope.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "pr8-multi-catalog-surface",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "user": {
            "name": "Alice",
            "totalScore": 128
          }
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "pr8-multi-catalog-surface",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["name-line", "custom-badge", "web-embed"]
          },
          {
            "id": "name-line",
            "component": "Text",
            "variant": "body",
            "text": {
              "@path": "/user/name"
            }
          },
          {
            "id": "custom-badge",
            "component": "A2UIBadge",
            "@catalogId": "https://a2ui.org/specification/v1_0/catalogs/custom_components/catalog.json",
            "label": {
              "@call": "describeTier",
              "catalogId": "https://a2ui.org/specification/v1_0/catalogs/custom_functions/catalog.json",
              "args": {"score":{"@path":"/user/totalScore"}}
            }
          },
          {
            "id": "web-embed",
            "component": "A2UIWeb",
            "@catalogId": "https://a2ui.org/specification/v1_0/catalogs/custom_components/catalog.json",
            "url": "https://a2ui.org"
          }
        ]
      }
    }
  ]
}

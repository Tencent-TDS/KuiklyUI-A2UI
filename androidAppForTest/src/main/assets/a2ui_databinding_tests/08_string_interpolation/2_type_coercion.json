{
  "name": "formatString · 类型自动转换",
  "description": "boolean / number / null 三种非字符串类型经 formatString 自动转成字符串输出。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "db-si-2",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "db-si-2",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          { "id": "col", "component": "Column", "children": ["title", "boolean", "number", "nullish"] },
          { "id": "title", "component": "Text", "text": "boolean / number / null 三种类型自动转字符串", "variant": "caption" },
          {
            "id": "boolean",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": { "value": "boolean → ${/flags/enabled}" },
              "returnType": "string"
            }
          },
          {
            "id": "number",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": { "value": "number → ${/stats/count}（不加格式化）" },
              "returnType": "string"
            }
          },
          {
            "id": "nullish",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": { "value": "missing path → 「${/nonexistent}」（应为空）" },
              "returnType": "string"
            }
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "db-si-2",
        "value": {
          "flags": { "enabled": true },
          "stats": { "count": 42 }
        }
      }
    }
  ]
}

{
  "name": "updateDataModel · 新增不存在的节点",
  "description": "初始 Data Model 不含 /profile/email，随后发送 path=/profile/email 的 upsert，将其从无到有创建。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "db-du-2",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "db-du-2",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          { "id": "col", "component": "Column", "children": ["title", "name", "email"] },
          { "id": "title", "component": "Text", "text": "upsert：从无到有创建 /profile/email", "variant": "caption" },
          {
            "id": "name",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": { "value": "姓名：${/profile/name}" },
              "returnType": "string"
            }
          },
          {
            "id": "email",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": { "value": "邮箱：${/profile/email}" },
              "returnType": "string"
            }
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "db-du-2",
        "value": { "profile": { "name": "Bob" } }
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "db-du-2",
        "path": "/profile/email",
        "value": "bob@example.com"
      }
    }
  ]
}

{
  "name": "FunctionCall 嵌套 · pluralize + formatNumber",
  "description": "外层 pluralize 的 one/other 分支内嵌套 formatString+formatNumber，formatNumber 的 value 又绑定路径。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "db-fb-2",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "db-fb-2",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          { "id": "col", "component": "Column", "children": ["title", "msg"] },
          { "id": "title", "component": "Text", "text": "嵌套 FunctionCall：pluralize + formatNumber", "variant": "caption" },
          {
            "id": "msg",
            "component": "Text",
            "text": {
              "call": "pluralize",
              "args": {
                "value": { "path": "/count" },
                "one": {
                  "call": "formatString",
                  "args": { "value": "共 ${formatNumber(value:${/count})} 条新消息" },
                  "returnType": "string"
                },
                "other": {
                  "call": "formatString",
                  "args": { "value": "共 ${formatNumber(value:${/count})} 条新消息" },
                  "returnType": "string"
                }
              },
              "returnType": "string"
            }
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "db-fb-2",
        "value": { "count": 12345 }
      }
    }
  ]
}

{
  "name": "相对路径 · 嵌入函数调用",
  "description": "模板内相对路径作为 formatCurrency 的参数，被 formatString 组合。",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "db-rp-3",
        "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "db-rp-3",
        "components": [
          { "id": "root", "component": "Card", "child": "col" },
          { "id": "col", "component": "Column", "children": ["title", "list"] },
          { "id": "title", "component": "Text", "text": "订单明细", "variant": "h5" },
          {
            "id": "list",
            "component": "Column",
            "children": { "componentId": "line-tpl", "path": "/lines" }
          },
          {
            "id": "line-tpl",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "${sku}：${qty} 件 × ${formatCurrency(value:${price}, currency:'CNY')}"
              },
              "returnType": "string"
            }
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "db-rp-3",
        "value": {
          "lines": [
            { "sku": "SKU-001", "qty": 2, "price": 49.9 },
            { "sku": "SKU-002", "qty": 1, "price": 199 },
            { "sku": "SKU-003", "qty": 5, "price": 12.5 }
          ]
        }
      }
    }
  ]
}

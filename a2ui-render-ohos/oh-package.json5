{
  "name": "@kuikly-a2ui-open/render",
  // Version is kept in sync with the single source of truth
  // `buildSrc/src/main/java/A2uiVersion.kt` (`DEFAULT_A2UI_SEMANTIC`).
  // OHPM enforces strict SemVer, so we use the plain semantic form here
  // (no Kotlin suffix). This repo doesn't bundle an ohpm publish script;
  // when publishing, edit this field by hand (and swap the local `file:`
  // dep to a semver), then run `ohpm pack` / `ohpm publish` from this dir.
  "version": "1.0.0",
  "description": "A2UI Render Module for HarmonyOS - bridges A2UI protocol to Kuikly native rendering",
  "main": "src/main/ets/Index.ets",
  "author": "Kuikly Team",
  "license": "KuiklyUI",
  "repository": "https://github.com/Tencent-TDS/KuiklyUI-A2UI",
  "homepage": "https://framework.tds.qq.com/",
  "keywords": ["kuikly", "a2ui", "cross-platform"],
  "dependencies": {
    // Default: consume the published @kuikly-open/render HAR from the
    // ohpm registry (artifact mode). When `kuikly.useSource=true`,
    // `scripts/apply-ohos-mode.sh` (invoked by `scripts/link-kuikly.sh`)
    // rewrites this field to `"file:../core-render-ohos"` so DevEco
    // picks up the local Kuikly checkout mirror instead.
    "@kuikly-open/render": "2.29.2"
  }
}

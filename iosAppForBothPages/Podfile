require_relative '../scripts/lib/kuikly_cocoapods'
require_relative '../scripts/lib/a2ui_cocoapods'

# Resolve Kuikly render pod source depending on `kuikly.useSource`.
# See `scripts/lib/kuikly_cocoapods.rb` for the resolution order.
kuikly_pod_version = A2UI::KuiklyCocoapods.render_pod_version(__dir__)
kuikly_pod_options = A2UI::KuiklyCocoapods.render_pod_options(__dir__)

# Resolve A2UI render pod source depending on `a2ui.useSource` (default
# source — same-repo dev loop).
a2ui_pod_version = A2UI::A2uiCocoapods.render_pod_version(__dir__)
a2ui_pod_options = A2UI::A2uiCocoapods.render_pod_options(__dir__)

platform :ios, '15.0'

target 'A2UIDemoApp' do
  use_modular_headers!

  # A2UIDemo.framework already embeds every Kotlin symbol from `:a2ui`
  # (see demo/build.2.1.21.gradle.kts), so a single Kotlin/Native framework
  # is enough for BothPages — it serves both the `A2UISurfaceDemo` Kuikly
  # page (hosted by `KuiklyPageCardViewController`) and the standalone
  # native `A2UISurfaceView` used by native-page demos. Linking `pod 'a2ui'`
  # additionally would produce duplicate stdlib-cache symbols.
  # The render pod resolves `A2UICoreEntry` at runtime via `NSClassFromString`.
  pod 'a2ui_demo', :path => '../demo'

  if kuikly_pod_version
    pod 'OpenKuiklyIOSRender', kuikly_pod_version
  else
    pod 'OpenKuiklyIOSRender', **kuikly_pod_options
  end
  if a2ui_pod_version
    pod 'OpenKuiklyA2UIIOSRender', a2ui_pod_version
  else
    pod 'OpenKuiklyA2UIIOSRender', **a2ui_pod_options
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
